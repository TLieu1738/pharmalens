APP_NAME=PharmaLens
ENVIRONMENT=development
ANTHROPIC_API_KEY=
# Required: model ID available in your Anthropic account
ANTHROPIC_MODEL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:5173
# Optional: raises the NCBI E-utilities rate limit from 3 to 10 requests/second
NCBI_API_KEY=
# Optional: free key from https://openalex.org/settings/api (without one, requests share a small daily budget)
OPENALEX_API_KEY=
# Allow signed-out users to run research (unlisted sessions, rate limited)
DEMO_MODE=true
